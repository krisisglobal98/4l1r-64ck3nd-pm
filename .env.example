# Copy to .env. Variables already set in the environment win over this file.
PORT=8081
# The service connects as the application role (alir_pm_app: not the owner, not a superuser), so Row-Level
# Security keeps every company (tenant) apart. The service refuses to start on a connection that bypasses it.
DATABASE_URL=postgres://alir_pm_app:APP_PASSWORD@localhost:5432/alir_pm_db?sslmode=disable
# The owner of the tables: migrations, seeds and make db-roles (never the running service).
MIGRATE_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/alir_pm_db?sslmode=disable
# Password of alir_pm_app, set by make db-roles.
PM_APP_PASSWORD=APP_PASSWORD
# Integration tests (make test-integration, as the owner); a separate database, its data is rolled back.
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/alir_pm_db_test?sslmode=disable
# The e2e service runs on the test database as the application role.
TEST_APP_DATABASE_URL=postgres://alir_pm_app:APP_PASSWORD@localhost:5432/alir_pm_db_test?sslmode=disable
# Acts for every request until the Authentication service issues tokens (full access).
PM_DEFAULT_USER=admin
# Its user id (UUID), stored in created_by/updated_by/deleted_by until users come from Authentication.
PM_DEFAULT_USER_ID=00000000-0000-7000-8000-000000000001
LOG_LEVEL=info
# jwt (tokens of the Authentication service) or default-user (development only: full access)
PM_AUTH_MODE=jwt
PM_AUTH_JWKS_URL=http://localhost:8083/.well-known/jwks.json
PM_AUTH_ISSUER=alir-auth
# Tenant of the default user (PM_AUTH_MODE=default-user); a request may name another with X-Tenant-ID.
PM_DEFAULT_TENANT_ID=00000000-0000-7000-8000-0000000000a1
